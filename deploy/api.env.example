# Configuration Laravel de production (copier en deploy/api.env).
# Ne JAMAIS committer deploy/api.env.
# DB_* et REVERB_HOST/PORT/SCHEME sont fournis par docker-compose.yml : ne pas les mettre ici.

APP_NAME="Digit Gateway API"
APP_ENV=production
APP_DEBUG=false
# Générer avec : docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://digitapp.guens.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Origine autorisée par CORS (le dashboard).
FRONTEND_URL=https://admin.digitapp.guens.org

# Logs dans le volume storage (storage/logs/laravel-AAAA-MM-JJ.log).
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

BCRYPT_ROUNDS=12

# Durée de vie des tokens de connexion (minutes). 43200 = 30 jours : l'utilisateur
# devra se reconnecter ensuite. Vide = tokens sans expiration (déconseillé).
SANCTUM_EXPIRATION=43200
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Durée de validité d'une cotation de change, en secondes.
EXCHANGE_QUOTE_TTL=300

# --- Reverb (WebSocket) ---
# REVERB_APP_KEY doit être IDENTIQUE à AppConfig.reverbKey de l'app Flutter,
# sinon les notifications temps réel ne fonctionnent pas.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
# Générer avec : openssl rand -hex 32
REVERB_APP_SECRET=

# --- Digitwave (fournisseur de paiement) ---
DIGITWAVE_BASE_URL=https://digitwave-services.com/api/
DIGITWAVE_API_KEY=
# Secret HMAC (préfixe agswhsec_) : sans lui, tous les webhooks sont rejetés.
DIGITWAVE_WEBHOOK_SECRET=

# --- Documents légaux (pages publiques /privacy et /terms + ré-acceptation dans l'app) ---
# Versions en vigueur : mêmes valeurs que `lastUpdated` dans digit_app/lib/data/legal/*.
# Les changer force tous les utilisateurs à ré-accepter au prochain lancement de l'app.
LEGAL_TERMS_VERSION=2026-10-04
LEGAL_PRIVACY_VERSION=2026-10-04
# Informations de l'éditeur affichées dans les textes (à compléter avant publication)
LEGAL_COMPANY= Agensic solution
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_COUNTRY=
LEGAL_JURISDICTION=
LEGAL_SUPPORT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_PHONE=
# Durée de conservation des données de transaction (ex : "10 ans")
LEGAL_RETENTION=

# Sous-domaine de la doc API marchande : même valeur que DOCS_DOMAIN de deploy/.env.
DOCS_DOMAIN=docs.digitapp.guens.org

# --- Sécurité de la console admin ---
# Exige la 2FA (TOTP) pour les actions sensibles : ajustement de solde, rapprochement,
# plafonds KYC, mot de passe d'un utilisateur, passage d'un marchand en production.
SECURITY_REQUIRE_ADMIN_2FA=true
# Double validation : au-delà de ce montant (XAF), ou pour tout ajustement demandé par un
# simple admin, un AUTRE superadmin doit approuver avant que le solde ne bouge.
SECURITY_ADJUSTMENT_APPROVAL_THRESHOLD=100000
# Nom affiché dans l'application d'authentification.
SECURITY_2FA_ISSUER="Digit Gateway"
# Disque privé des pièces KYC (local ou s3).
KYC_DISK=local

# --- Supervision (voir README § 7) ---
# Alertes sur changement d'état d'un contrôle : webhook Slack/Discord/Mattermost/ntfy et/ou e-mail
# (e-mail : configurer aussi MAIL_MAILER/MAIL_HOST… ci-dessus, `log` n'envoie rien).
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_EMAIL=
# URL "ping" appelée chaque minute (healthchecks.io / Uptime Kuma push) : l'outil externe alerte si les pings s'arrêtent.
MONITOR_HEARTBEAT_URL=
# Seuils (valeurs par défaut) :
# MONITOR_QUEUE_LAG_MINUTES=5
# MONITOR_UNSUBMITTED_MINUTES=10
# MONITOR_FAILURE_RATE=0.5
# MONITOR_FAILURE_MIN_VOLUME=5
# MONITOR_MIN_FREE_DISK_MB=2048
