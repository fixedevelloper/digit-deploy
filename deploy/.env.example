# Variables lues par docker-compose.yml (copier en deploy/.env).
# Ne JAMAIS committer deploy/.env.

# Domaines (les enregistrements DNS A/AAAA doivent pointer vers le serveur AVANT le démarrage).
# API_DOMAIN doit correspondre à baseUrl / reverbWHost de digit_app/lib/config/app_config.dart.
API_DOMAIN=digitapp.guens.org
DASHBOARD_DOMAIN=admin.digitapp.guens.org
# Sous-domaine de la doc API marchande (obligatoire : Caddy le sert). Mettre la même
# valeur dans DOCS_DOMAIN de api.env.
DOCS_DOMAIN=docs.digitapp.guens.org
# Lien vers la doc affiché par le dashboard (intégré au build).
DASHBOARD_DOCS_URL=https://docs.digitapp.guens.org

# Email de contact pour Let's Encrypt (alertes d'expiration des certificats).
ACME_EMAIL=admin@example.com

# Base MySQL — générer des mots de passe forts : openssl rand -base64 24
DB_DATABASE=digit_gateway
DB_USERNAME=digit
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sauvegardes (service "backup") ---
# Heure quotidienne (UTC) et durée de conservation locale.
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
# Chiffre les sauvegardes (AES-256). Elles contiennent des données personnelles et des pièces KYC :
# générer avec `openssl rand -base64 32` et CONSERVER CETTE PHRASE AILLEURS (sans elle, les
# sauvegardes sont illisibles). Vide = non chiffré.
BACKUP_PASSPHRASE=
# Copie hors serveur (indispensable : sinon une panne du serveur perd aussi les sauvegardes).
# Exemple S3/MinIO/Backblaze/Wasabi : le remote s'appelle "offsite".
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_OFFSITE_TYPE=
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Alerte en cas d'échec (URL de webhook Slack/Discord/Mattermost…) et signal de bonne santé
# (URL "ping" de healthchecks.io / Uptime Kuma : alerte si AUCUN ping n'arrive à temps).
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_HEARTBEAT_URL=
# Jour du test de restauration automatique (1=lundi … 7=dimanche, vide = désactivé).
BACKUP_VERIFY_WEEKDAY=7
